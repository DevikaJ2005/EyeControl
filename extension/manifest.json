{
  "manifest_version": 3,
  "name": "EyeControl — Gaze Web Controller & Adaptive Grid",
  "version": "1.1.0",
  "description": "Gaze tracking, adaptive grid navigation, and gaze-zone scrolling for YouTube, India Today and top web destinations.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "*://*.youtube.com/*",
    "*://*.indiatoday.in/*",
    "*://*.ndtv.com/*",
    "*://*.timesofindia.indiatimes.com/*",
    "*://*.thehindu.com/*",
    "*://*.indianexpress.com/*",
    "*://*.hindustantimes.com/*",
    "*://*.aajtak.in/*",
    "*://*.bbc.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:5174/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:5174/*"
      ],
      "js": ["bridge_injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.indiatoday.in/*",
        "*://*.ndtv.com/*",
        "*://*.timesofindia.indiatimes.com/*",
        "*://*.thehindu.com/*",
        "*://*.indianexpress.com/*",
        "*://*.hindustantimes.com/*",
        "*://*.aajtak.in/*",
        "*://*.bbc.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EyeControl Gaze Controller & Grid"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
